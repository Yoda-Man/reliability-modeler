# Reliability Modeler — environment template
#
#   cp .env.example .env
#   chmod 600 .env
#
# Then fill in the REQUIRED values. `docker compose` refuses to start if a
# required value is missing. Never commit .env.

# ════════════════════════════════════════════════════════════════════════════
# REQUIRED
# ════════════════════════════════════════════════════════════════════════════

# Shared secret between the UI proxy and the API. Every API route except
# /health and /health/live requires it (X-API-Key header). The API refuses to
# start when it is empty. Generate one with:
#   openssl rand -hex 32
RELIABILITY_API_KEY=

# Password for the UI login prompt (HTTP Basic auth). If empty the UI answers
# every request with 503 "UI_PASSWORD not configured". Generate one with:
#   openssl rand -base64 24
UI_PASSWORD=

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Sentry
# ════════════════════════════════════════════════════════════════════════════

# Sentry org auth token with event:read + project:read scopes. Without it the
# API runs but /health reports "degraded" and ingestion fails.
SENTRY_AUTH_TOKEN=

# Override for self-hosted Sentry.
# SENTRY_BASE_URL=https://sentry.io/api/0/

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — UI
# ════════════════════════════════════════════════════════════════════════════

# Username for the UI login prompt.
# UI_USERNAME=admin

# Host port the UI is published on.
# UI_PORT=3000

# Proxy timeout (ms) for UI -> API requests. Keep above ANALYSIS_TIMEOUT_SECONDS.
# PROXY_TIMEOUT_MS=130000

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — API tuning
# ════════════════════════════════════════════════════════════════════════════

# Comma-separated CORS origins. The browser talks to the UI proxy, so this only
# matters if something calls the API directly from a browser.
# ALLOWED_ORIGINS=http://localhost:3000

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Days to keep archives/analyses/plots. Pruned at startup and daily. 0 disables.
# RETENTION_DAYS=90

# Maximum seconds for a single analysis request.
# ANALYSIS_TIMEOUT_SECONDS=120

# Maximum request body size (bytes) for POST routes.
# MAX_BODY_BYTES=1048576

# Requests per minute per client IP.
# RATE_LIMIT_PER_MINUTE=30

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — image selection / release
# ════════════════════════════════════════════════════════════════════════════

# Image tag to run (e.g. 2.9.0). Pin this in production; use it for rollback.
# IMAGE_TAG=latest

# Docker Hub namespace the images are pulled from.
# DOCKERHUB_NAMESPACE=trustaldo

# Docker Hub username used by `make push`.
# DOCKERHUB_USERNAME=trustaldo

# ════════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT ONLY — never set these in a shared deployment
# ════════════════════════════════════════════════════════════════════════════
# ALLOW_INSECURE_NO_AUTH=true   # API starts without RELIABILITY_API_KEY (loud warning)
# UI_AUTH_DISABLED=true         # UI skips the login prompt
# (These are not passed through docker-compose.yml; use them with `uvicorn` / `npm run dev`.)
