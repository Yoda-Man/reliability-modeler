# Build context hygiene for images built from the repository root
# (web/api/Dockerfile). Keep secrets, VCS data, runtime output and tooling out.

# VCS / secrets
.git
.gitignore
.env
.env.*
!.env.example

# Runtime data
output/
backups/
temp_plots/
temp_uploads/
logs/
settings.json
web/api/settings.json

# Not part of the API image
mcp_server/

# Generated / planning artefacts
graphify-out/
openspec/
Reference_Release/
tests/
.coverage
coverage/
htmlcov/
.pytest_cache/

# Python caches / envs
**/__pycache__/
**/*.pyc
.venv/
venv/

# UI build artefacts (UI image uses its own context: web/ui)
web/ui/node_modules/
web/ui/.next/

# Editor / AI tool directories
.DS_Store
.vscode/
.idea/
.github/
.agent/
.amazonq/
.augment/
.bob/
.claude/
.cline/
.clinerules/
.codebuddy/
.codex/
.continue/
.cospec/
.crush/
.cursor/
.factory/
.forge/
.gemini/
.iflow/
.junie/
.kilocode/
.kimi/
.kiro/
.lingma/
.opencode/
.pi/
.qoder/
.qwen/
.reasonix/
.roo/
.trae/
.vibe/
.windsurf/
